NODE_ENV=development
PORT=3000

# PostgreSQL is expected to be provided locally (system service or your own container)
# rather than by `docker compose`: the compose file only ships Redis and MinIO. 5432 is
# the standard port a local install listens on — adjust if yours differs.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ticket_checker
DB_PASSWORD=ticket_checker
DB_NAME=ticket_checker
DB_LOGGING=false

JWT_ACCESS_SECRET=changeme_access_secret_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme_refresh_secret_min_32_characters
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Base URL of the frontend app, used to build links embedded in emails (e.g.
# the password reset link). Optional -- falls back to http://localhost:3000
# with a startup warning when unset.
APP_FRONTEND_URL=http://localhost:3000

SWAGGER_ENABLED=true
SWAGGER_PATH=docs

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@ticket-checker.local
SEED_ADMIN_PASSWORD=Admin@1234

# Matches the `redis` service in docker-compose.yml. Host port is shifted to
# 6380 (Redis' default is 6379) for the same reason DB_PORT is 5434: avoid
# clashing with a Redis instance already running locally for another project.
REDIS_HOST=localhost
REDIS_PORT=6380
# REDIS_PASSWORD=
# REDIS_DB=0

# Matches the `minio` service in docker-compose.yml. MinIO's default ports
# (9000 API / 9001 console) are shifted to 9002/9003 on the host for the same
# reason DB_PORT is 5434: avoid clashing with other local dev tooling.
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=ticket-checker-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin12345
# Required by MinIO: forces path-style addressing (host/bucket/key) instead
# of AWS-only virtual-hosted-style (bucket.host/key).
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,application/pdf

# Mailpit is the local dev SMTP catch-all (see the `mailpit` service in
# docker-compose.yml): it accepts mail on 1025 and requires no
# authentication -- unlike a real SMTP server, it would reject an AUTH
# attempt, so MAIL_USERNAME/MAIL_PASSWORD must stay empty here.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Ticket Checker
MAIL_USE_TLS=false
MAIL_USE_SSL=false
# Safety net: when set, every outgoing mail is redirected to this address
# instead of its real recipient. Strongly recommended outside production,
# since the SMTP server above delivers to real mailboxes.
MAIL_SANDBOX_TO=sandbox@example.com

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
THROTTLE_LOGIN_TTL_SECONDS=60
THROTTLE_LOGIN_LIMIT=5

LOG_LEVEL=debug
