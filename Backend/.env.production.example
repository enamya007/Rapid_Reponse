# Production environment template. Copy to `.env.production`, fill in real
# values, and never commit the copy (it is git-ignored on purpose).
#
#   cp .env.production.example .env.production

NODE_ENV=production
PORT=3000

# `postgres` is the service name of the DB container in docker-compose.prod.yml
# (containers resolve each other by service name on the compose network) --
# not `localhost`, and not the 5434 host port used by the dev compose file.
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=ticket_checker_prod
DB_PASSWORD=changeme_use_a_long_random_value
DB_NAME=ticket_checker
DB_LOGGING=false

# Both secrets must be at least 32 random characters and unique per
# environment (never reuse a dev/staging secret in prod, and never reuse the
# access secret for the refresh secret). Generate one per line with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_random_generated_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_random_generated_secret_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of the real frontend origin(s) allowed to call the API.
CORS_ORIGINS=https://app.example.com

# Base URL of the frontend app, used to build links embedded in emails (e.g.
# the password reset link).
APP_FRONTEND_URL=https://app.example.com

# Deliberately ON in production: the frontend team pulls the OpenAPI document
# straight from the deployed API to generate its client, with no manual export
# step and no way for the spec to lag behind the running build. This exposes
# three unauthenticated routes (they are registered by SwaggerModule on the
# HTTP adapter itself, so they bypass the `/api` prefix, the global guards and
# the throttler):
#
#   /docs        the browsable Swagger UI
#   /docs-json   the OpenAPI document (JSON)
#   /docs-yaml   the OpenAPI document (YAML)
#
# What this reveals is the API's shape -- every route, parameter and payload --
# never any data: the endpoints themselves stay behind JWT auth. Set to false
# if that surface must not be public; the frontend then needs another channel
# (see `pnpm openapi:generate`).
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme_use_a_strong_password

# `redis` is the service name of the Redis container in docker-compose.prod.yml
# (same reasoning as DB_HOST above) -- not localhost, and not a host-mapped port.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_random_generated_password
# REDIS_DB=0

# `minio` is the service name of the MinIO container in docker-compose.prod.yml.
# Swap for a managed S3-compatible endpoint if you are not self-hosting MinIO.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ticket-checker-attachments
S3_ACCESS_KEY=replace_with_a_random_generated_access_key
S3_SECRET_KEY=replace_with_a_random_generated_secret_key
# Required by MinIO: forces path-style addressing (host/bucket/key) instead
# of AWS-only virtual-hosted-style (bucket.host/key).
S3_FORCE_PATH_STYLE=true
# Public-facing URL used to build links to stored files (e.g. behind a reverse
# proxy/CDN in front of MinIO). Leave unset to disable direct public links.
# S3_PUBLIC_URL=https://files.example.com
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,application/pdf

# Real SMTP credentials for a real mail server -- provide via a secrets
# manager or CI/CD secret store, never commit the filled-in file.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_real_smtp_username
MAIL_PASSWORD=replace_with_real_smtp_password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Ticket Checker
MAIL_USE_TLS=true
MAIL_USE_SSL=false
# Leave unset in production so mail reaches its real recipients. Only set this
# temporarily (e.g. a staging environment sharing prod SMTP credentials) to
# redirect every outgoing mail to a single safe address instead.
# MAIL_SANDBOX_TO=sandbox@example.com

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
THROTTLE_LOGIN_TTL_SECONDS=60
THROTTLE_LOGIN_LIMIT=5

LOG_LEVEL=info
