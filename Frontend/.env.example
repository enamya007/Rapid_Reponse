# Copiez tout le contenu de ce fichier dans un nouveau fichier nommé .env.local
# (à la racine du dossier Frontend, à côté de package.json).
# Next.js lit .env.local en priorité.

# URL de l'API NestJS, vue par le navigateur. Doit se terminer par /api.
# Le Backend écoute sur le port 4000 en local (voir Backend/.env dans la variable  PORT).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# URL publique du site Next.js. C'est l'adresse que vous ouvrez dans le navigateur.
NEXTAUTH_URL=http://localhost:3000

#  NextAuth c'est la valeur secrete utilisé par NextAuthpour signer la session.
#Ce n'est pas un mot de passe de compte.
# Remplacez la valeur ci-dessous par le résultat de la commande:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#Cette commande ci-dessus doit êtrWe copier dans l'invite de commande afin de generer
#32 caractères aléatoires à donner comme valeur à NEXTAUTH_SECRET
NEXTAUTH_SECRET=remplacez-moi-par-une-longue-chaine-secrete
